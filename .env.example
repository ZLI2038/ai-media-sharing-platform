# Use a long random value in production.
TOKEN_SECRET=replace-with-a-long-random-secret

# Required for the document's AI image-generation feature.
OPENAI_API_KEY=

# The original CRA frontend used this browser variable.
# The hosted replica keeps the same reference while calling OpenAI on the server
# so the real key is never exposed in the browser.
REACT_APP_OPENAI_KEY=XXXXXXXX
